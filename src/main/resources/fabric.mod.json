			"io.github.avi130805.redplanet.client.datagen.RedPlanetDataGenerator"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"mixins": [
		"redplanet.mixins.json",
		{
			"config": "redplanet.client.mixins.json",
			"environment": "client"
