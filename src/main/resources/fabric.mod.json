{
	"schemaVersion": 1,
	"id": "redplanet",
	"version": "${version}",
	"name": "Red Planet: Starship to Mars",
	"description": "A scientifically grounded Mars dimension, reached by riding a full-scale Starship from launch to landing, and the same flight home.",
	"authors": [
		"Avi130805"
	],
	"contact": {
		"sources": "https://github.com/Avi130805/red-planet"
	},
	"license": "MIT",
	"icon": "assets/redplanet/icon.png",
